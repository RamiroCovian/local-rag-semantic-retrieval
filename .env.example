# Copiá este archivo a .env y completá los valores
# Nunca subas .env al repositorio

# Proveedor activo: openai | anthropic | gemini
LLM_PROVIDER=openai

# --- API keys (completá solo las que uses) ---
OPENAI_API_KEY=sk-tu-api-key-aqui
ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui
GOOGLE_API_KEY=tu-gemini-api-key-aqui

# --- Modelos de chat por proveedor ---
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest
GEMINI_CHAT_MODEL=gemini-2.0-flash

# --- Embeddings ---
# Importante: usá SIEMPRE el mismo modelo para indexar y consultar.
# Por defecto usamos OpenAI embeddings (funciona aunque el chat sea de otro provider).
# Si preferís embeddings locales/gratis, más adelante se puede cambiar a HuggingFace.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
